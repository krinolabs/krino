{
  "name": "@krinolabs/bench",
  "version": "0.0.0",
  "description": "Mock 100-tool catalog, fake executors, and task set for krino benchmarks. Not published.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/hosts/ai-sdk.d.ts",
      "import": "./dist/hosts/ai-sdk.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/hosts/claude-agent-sdk.d.ts",
      "import": "./dist/hosts/claude-agent-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "ai": "7.0.126",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@krinolabs/krino": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
