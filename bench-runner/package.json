{
  "name": "@krinolabs/bench-runner",
  "version": "0.0.0",
  "description": "krino-bench: runs the three-setup tool-selection benchmark on the bench catalog. Not published.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "krino-bench": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@krinolabs/bench": "workspace:*",
    "@krinolabs/cli": "workspace:*",
    "@krinolabs/example-ai-sdk-cli": "workspace:*",
    "@krinolabs/krino": "workspace:*",
    "ai": "7.0.126"
  }
}
