{
  "name": "@krinolabs/krino",
  "version": "0.0.1",
  "description": "Decision layer for AI agents: see, price, and safely cheapen the small decisions your agent makes. Early and experimental.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "ai-sdk",
    "claude-agent-sdk",
    "anthropic",
    "tool-calling",
    "prompt-caching"
  ],
  "homepage": "https://krino.sush.dev",
  "bugs": {
    "url": "https://github.com/krinolabs/krino/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krinolabs/krino.git",
    "directory": "packages/krino"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk/index.d.ts",
      "import": "./dist/adapters/ai-sdk/index.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/adapters/claude-agent-sdk/index.d.ts",
      "import": "./dist/adapters/claude-agent-sdk/index.js"
    },
    "./providers/jev": {
      "types": "./dist/providers/jev-ai-gateway/index.d.ts",
      "import": "./dist/providers/jev-ai-gateway/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "smoke:jev": "tsup && tsc -p scripts/tsconfig.json && node --experimental-strip-types scripts/smoke-jev.ts",
    "live:ai-sdk": "tsup && tsc -p scripts/tsconfig.json && node --experimental-strip-types scripts/live-ai-sdk.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "@earendil-works/pi-ai": ">=1.1.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.1.0 <2",
    "ai": ">=7.0.111 <8"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@vitest/coverage-v8": "5.0.3",
    "ai": "7.0.126",
    "fast-check": "4.10.2",
    "zod": "4.6.5"
  }
}
