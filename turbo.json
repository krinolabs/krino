{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["KRINO_LIVE"],
      "passThroughEnv": ["AI_GATEWAY_API_KEY"]
    },
    "lint": {},
    "format": {
      "cache": false
    }
  }
}
